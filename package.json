{
  "name": "rrze-legal",
  "title": "RRZE Legal",
  "version": "2.8.53",
  "description": "Legal Mandatory Information & GDPR.",
  "main": "rrze-legal.php",
  "textdomain": "rrze-legal",
  "private": true,
  "compatibility": {
    "wprequires": "6.9.4",
    "wptestedup": "7.1",
    "phprequires": "8.3"
  },
  "supports": {
    "email": "webmaster@fau.de"
  },
  "author": {
    "name": "RRZE-Webteam <webmaster@fau.de>",
    "url": "https://www.wp.rrze.fau.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RRZE-Webteam/rrze-legal",
    "clone": "https://github.com/RRZE-Webteam/rrze-legal.git",
    "issues": "https://github.com/RRZE-Webteam/rrze-legal/issues"
  },
  "license": "GNU General Public License v3",
  "licenseurl": "http://www.gnu.org/licenses/gpl-3.0.html",
  "tags": "Plugin, WordPress, DSGVO, GDPR, Consent, RRZE",
  "engines": {
    "node": ">=22.10.0",
    "npm": ">=10.9.0"
  },
  "devDependencies": {
    "@wordpress/block-editor": "^20.0.0",
    "@wordpress/blocks": "^17.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/scripts": "^37.1.0",
    "esbuild": "^0.28.2",
    "jquery": "^4.0.0",
    "jsdom": "^31.0.1",
    "sass": "^1.96.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "npm run build:assets:dev && npm run build:wordpress:dev",
    "build:assets:dev": "node scripts/build-assets.js dev",
    "build:assets:prod": "node scripts/build-assets.js prod",
    "build:wordpress:dev": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks --mode=development",
    "build:wordpress:prod": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks",
    "start": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks",
    "readme": "node scripts/build-readme.js",
    "version:dev": "node scripts/build-version.js dev",
    "version:prod": "node scripts/build-version.js prod",
    "version:release": "node scripts/build-version.js release",
    "dev": "npm run build && npm run version:dev && npm run readme",
    "prod": "npm run build:assets:prod && npm run build:wordpress:prod && npm run version:prod && npm run readme",
    "release": "npm run build:assets:prod && npm run build:wordpress:prod && npm run version:release && npm run readme"
  }
}
