  },
  "author": {
    "name": "RRZE-Webteam <webmaster@fau.de>",
    "url": "https://www.wp.rrze.fau.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RRZE-Webteam/rrze-legal",
    "clone": "https://github.com/RRZE-Webteam/rrze-legal.git",
    "issues": "https://github.com/RRZE-Webteam/rrze-legal/issues"
  },
  "license": "GNU General Public License v3",
  "licenseurl": "http://www.gnu.org/licenses/gpl-3.0.html",
  "tags": "Plugin, WordPress, Legal, DSGVO, GDPR, Consent, RRZE, FAU",
  "engines": {
    "node": ">=22.10.0",
    "npm": ">=10.9.0"
  },
  "devDependencies": {
    "@wordpress/scripts": "^33.0.0"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "scripts": {
    "start": "wp-scripts start",
    "watch": "wp-scripts start",
    "build": "wp-scripts build",
    "readme": "node scripts/build-readme.js",
    "version:dev": "node scripts/build-version.js dev",
    "version:prod": "node scripts/build-version.js prod",
    "version:release": "node scripts/build-version.js release",
    "dev": "npm run build && npm run version:dev && npm run readme",
    "prod": "npm run build && npm run version:prod && npm run readme",
    "release": "npm run build && npm run version:release && npm run readme",
    "format": "wp-scripts format src",
    "lint:js": "wp-scripts lint-js src",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses --prod --gpl3",
    "packages-update": "wp-scripts packages-update"
  }
