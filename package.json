{
  "name": "rrze-legal",
  "title": "RRZE Legal",
  "version": "2.8.15",
  "description": "Legal Mandatory Information & GDPR.",
  "main": "rrze-legal.php",
  "textdomain": "rrze-legal",
  "private": true,
  "compatibility": {
    "wprequires": "6.9.4",
    "wptestedup": "7.0",
    "phprequires": "8.3"
  },
  "supports": {
