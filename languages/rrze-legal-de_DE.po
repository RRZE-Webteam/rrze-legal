msgstr "Feedback-Formular zur Barrierefreiheit"

#: settings/tos.php:974
msgid "Contact Phone"
msgstr "Telefon"

#: settings/tos.php:975
msgid "Contact number for telephone assistance."
msgstr "Kontaktnummer für telefonische Hilfestellung."

#: settings/tos.php:981
msgid "Contact Address"
msgstr "Adresse"

#: settings/tos.php:982
msgid "Postal address as an alternative to email address."
msgstr "Postanschrift als Alternative zur E-Mail-Adresse."

